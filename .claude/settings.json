{
  "worktree": { "baseRef": "head" },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",

      "Edit(./bun.lock)",
      "Write(./bun.lock)",

      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",

      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item * -Recurse*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(bun add *)",
      "Bash(bun remove *)"
    ]
  }
}
