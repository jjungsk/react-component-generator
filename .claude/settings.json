{
  "worktree": { "baseRef": "head" },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "out=$(bun --bun run test 2>&1) || { echo \"테스트 실패: 모든 테스트가 통과해야 커밋할 수 있습니다.\" >&2; echo \"$out\" | tail -40 >&2; exit 2; }",
            "timeout": 180,
            "onFailure": "block",
            "statusMessage": "커밋 전 테스트 실행 중..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$CLAUDE_PROJECT_DIR/.claude/hooks/tdd-reminder.ts\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Write(./.env)",
      "Write(./.env.*)",

      "Edit(./bun.lock)",
      "Write(./bun.lock)",

      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- *)",
      "Bash(git branch -D *)",

      "Bash(cat *.env*)",
      "Bash(type *.env*)",
      "Bash(Get-Content *.env*)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(rm -rf *)",
      "Bash(Remove-Item * -Recurse*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(bun add *)",
      "Bash(bun remove *)"
    ]
  }
}
